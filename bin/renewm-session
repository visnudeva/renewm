#!/usr/bin/env bash
# Ly entry for renewm — uses renewm-venv and shows errors on the VT.
set -uo pipefail

export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-newm}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-newm}"

REPO="${RENEWM_DIR:-${HOME}/code/GITHUB/renewm}"
export RENEWM_DIR="$REPO"
VENV_PY="${HOME}/.local/share/renewm-venv/bin/python"
export RENEWM_VENV_PYTHON="$VENV_PY"
LOG="${HOME}/.cache/newm_log"
mkdir -p "$(dirname "$LOG")"

if [[ -d "${REPO}/newm" ]]; then
  export PYTHONPATH="${REPO}${PYTHONPATH:+:$PYTHONPATH}"
fi
if [[ -d "${REPO}/../repywm/pywm" ]]; then
  export PYTHONPATH="$(cd "${REPO}/../repywm" && pwd)${PYTHONPATH:+:$PYTHONPATH}"
fi

fail() {
  {
    echo
    echo "======== renewm failed ========"
    echo "$*"
    echo "Log: $LOG"
    echo "==============================="
    echo
  } | tee -a "$LOG" >&2
  sleep 12
  exit 1
}

{
  echo "---- renewm-session $(date -Iseconds) ----"
  echo "USER=$USER REPO=$REPO VENV_PY=$VENV_PY"
  ls -l "$VENV_PY" "${HOME}/.local/bin/start-newm" 2>&1 || true
  ls -l "${REPO}/../repywm/pywm/_pywm.so" 2>&1 || true
} >>"$LOG" 2>&1

START=""
if [[ -x "${HOME}/.local/bin/start-newm" ]]; then
  START="${HOME}/.local/bin/start-newm"
elif [[ -x "${REPO}/bin/start-newm" ]]; then
  START="${REPO}/bin/start-newm"
else
  fail "start-newm not found. Run: cd ${REPO} && ./install.sh"
fi

PY="${VENV_PY}"
[[ -x "$PY" ]] || PY="$(command -v python3)"

if ! "$PY" - <<'PY' >>"$LOG" 2>&1
import sys
print("python", sys.version, sys.executable)
import pywm
print("pywm", pywm.__file__)
import newm
print("newm", newm.__file__)
print("imports OK")
PY
then
  fail "Python import failed. Last log lines:
$(tail -n 40 "$LOG")

Fix: cd ${REPO} && ./install.sh
Check: ${VENV_PY} -c 'import newm, pywm; print(\"ok\")'"
fi

set +e
"$START" -d "$@" 2>&1 | tee -a "$LOG"
rc=${PIPESTATUS[0]}
set -e

if [[ "$rc" -ne 0 ]]; then
  fail "start-newm exited ${rc}. Last log lines:
$(tail -n 60 "$LOG")"
fi
exit "$rc"
