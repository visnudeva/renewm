#!/usr/bin/env bash
# Ly / display-manager entry. Absolute-path friendly; sets PATH for pip --user.
set -euo pipefail

export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"

REPO="${RENEWM_DIR:-${HOME}/code/GITHUB/renewm}"
export RENEWM_DIR="$REPO"
LOG="${HOME}/.cache/newm_log"
mkdir -p "$(dirname "$LOG")"

if [[ -d "${REPO}/newm" ]]; then
  export PYTHONPATH="${REPO}${PYTHONPATH:+:$PYTHONPATH}"
fi
if [[ -d "${REPO}/../repywm/pywm" ]]; then
  export PYTHONPATH="$(cd "${REPO}/../repywm" && pwd)${PYTHONPATH:+:$PYTHONPATH}"
fi

if [[ -x "${HOME}/.local/bin/start-newm" ]]; then
  exec "${HOME}/.local/bin/start-newm" "$@"
fi
if [[ -x "${REPO}/bin/start-newm" ]]; then
  exec "${REPO}/bin/start-newm" "$@"
fi

{
  echo "renewm-session: start-newm not found"
  echo "  looked for: ${HOME}/.local/bin/start-newm"
  echo "  looked for: ${REPO}/bin/start-newm"
  echo "  fix: cd ${REPO} && ./install.sh"
} >"$LOG" 2>&1
# Also surface on the Ly-visible console if any
echo "renewm-session: start-newm not found — see ${LOG}" >&2
exit 127
